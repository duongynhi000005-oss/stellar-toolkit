{
  "name": "@hyperdevtools/stellar-toolkit",
  "version": "0.1.0",
  "description": "A comprehensive utility library for Stellar blockchain development",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "cryptocurrency",
    "sdk",
    "utilities",
    "helpers",
    "xlm",
    "stellar-sdk"
  ],
  "author": "HyperDevTools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HyperDevTools/stellar-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/HyperDevTools/stellar-toolkit/issues"
  },
  "homepage": "https://github.com/HyperDevTools/stellar-toolkit#readme",
  "dependencies": {
    "stellar-sdk": "^11.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
